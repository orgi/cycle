<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Network: map-region downloads (OpenAndroMaps) + ride uploads (Strava/
         Komoot). Without this a release build's HTTP calls fail instantly;
         debug/profile builds get it auto-added for tooling, which hid the bug. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- "All files access" (opt-in, Settings → Data → Import from OruxMaps):
         lets a bulk OruxMaps oruxmapstracks.db import read it straight out of
         OruxMaps' own storage, which Android 11+ otherwise blocks every other
         app (including file managers) from reaching. Not used for anything
         else. Personal sideload, not Play-distributed, so Play's restricted
         permission policy for MANAGE_EXTERNAL_STORAGE doesn't apply. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage"/>
    <!-- Live GPS tracking. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- geolocator's location service (and M4 background recording) needs a
         foreground service of type "location" on Android 14+. Without these the
         location service fails to start and no position updates are delivered. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- Keep the handlebar display awake (wakelock_plus). -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- BLE cycling sensors (HR / speed-cadence / power). neverForLocation: we
         don't derive location from BLE scans, so scanning needs no location. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30"/>

    <application
        android:label="cycle"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:largeHeap="true"><!-- headroom for large offline maps -->

        <!-- singleTask (not singleTop): opening/sharing a .gpx from a file
             manager launches with FLAG_ACTIVITY_NEW_TASK, which under singleTop
             (+ taskAffinity="") spawned a *second* app instance. singleTask routes
             the VIEW/SEND intent to the existing instance via onNewIntent even
             from another task, so there's only ever one Cycle. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- We handle opened/shared .gpx files ourselves via the
                 cycle/incoming_gpx MethodChannel. Disable Flutter's URI deep
                 linking so go_router doesn't try to route the file:// intent
                 data and show "Page Not Found". -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Open a .gpx file with Cycle (file managers, downloads, mail
                 attachments). GPX mime types vary, so match the common ones. -->
            <intent-filter android:label="Follow GPX route">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:host="*"/>
                <data android:mimeType="application/gpx+xml"/>
                <data android:mimeType="application/xml"/>
                <data android:mimeType="text/xml"/>
            </intent-filter>
            <!-- Fall back to matching by .gpx extension when the mime type is
                 generic/unknown (common for downloads and file:// URIs). -->
            <intent-filter android:label="Follow GPX route">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:host="*"/>
                <data android:mimeType="application/octet-stream"/>
                <data android:pathPattern=".*\\.gpx"/>
                <data android:pathPattern=".*\\..*\\.gpx"/>
            </intent-filter>
            <!-- Share a .gpx to Cycle. -->
            <intent-filter android:label="Follow GPX route">
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/gpx+xml"/>
                <data android:mimeType="application/octet-stream"/>
                <data android:mimeType="application/xml"/>
                <data android:mimeType="text/xml"/>
            </intent-filter>
            <!-- Open a .sqlite ride-database backup with Cycle (from a cloud
                 storage app, file manager, mail, etc. — mirrors .gpx above).
                 SQLite has no widely-registered mime type, so most incoming
                 intents arrive as application/octet-stream and are matched by
                 extension instead. -->
            <intent-filter android:label="Import ride backup">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:host="*"/>
                <data android:mimeType="application/octet-stream"/>
                <data android:mimeType="application/vnd.sqlite3"/>
                <data android:mimeType="application/x-sqlite3"/>
                <data android:pathPattern=".*\\.sqlite"/>
            </intent-filter>
            <!-- Share a .sqlite backup to Cycle. -->
            <intent-filter android:label="Import ride backup">
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/octet-stream"/>
                <data android:mimeType="application/vnd.sqlite3"/>
                <data android:mimeType="application/x-sqlite3"/>
            </intent-filter>
            <!-- Open an OruxMaps oruxmapstracks.db track database with Cycle
                 (from a file manager — mirrors .sqlite above). No PC/adb
                 needed: the user shares the file from wherever OruxMaps
                 stores it, and Cycle imports it on receipt. -->
            <intent-filter android:label="Import OruxMaps tracks">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:host="*"/>
                <data android:mimeType="application/octet-stream"/>
                <data android:mimeType="application/vnd.sqlite3"/>
                <data android:mimeType="application/x-sqlite3"/>
                <data android:pathPattern=".*\\.db"/>
            </intent-filter>
            <!-- Share an OruxMaps oruxmapstracks.db to Cycle. -->
            <intent-filter android:label="Import OruxMaps tracks">
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/octet-stream"/>
                <data android:mimeType="application/vnd.sqlite3"/>
                <data android:mimeType="application/x-sqlite3"/>
            </intent-filter>
            <!-- Strava OAuth redirect (cycle://strava-callback?code=…). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="cycle" android:host="strava-callback"/>
            </intent-filter>
        </activity>
        <!-- FileProvider for "Share backup": exposes a file:// backup as a
             content:// Uri so ACTION_SEND can hand it to another app
             (OneDrive, Drive, email, …) without granting broader file access. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
        <!-- flutter_foreground_task service (keeps recording alive in the
             background). foregroundServiceType=location: we record GPS. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="location"
            android:exported="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
