<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Live GPS tracking while riding. "When in use" is all Cycle requests: a
	     ride started in the foreground keeps recording with the screen off via
	     the `location` background mode below (iOS shows the blue location pill).
	     The Always text is required by geolocator's plugin build regardless. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Cycle uses your location to measure speed, distance and your route while you ride.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Cycle uses your location to keep recording your ride while the screen is off.</string>
	<!-- location: keep a recording ride's GPS running when backgrounded (the
	     Dart-side gate in AppleLocationService releases it when no ride runs).
	     bluetooth-central: keep BLE sensor notifications flowing meanwhile. -->
	<!-- Expose the app's Documents folder in the Files app ("On My iPhone →
	     Cycle"): the iOS equivalent of Android's external files dir, where the
	     routes/ folder, backups and GPX exports live. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>bluetooth-central</string>
	</array>
	<!-- BLE cycling sensors (heart rate, speed/cadence, power). -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Cycle connects to Bluetooth sensors for heart rate, cadence, speed and power.</string>
	<!-- Ride sync to a server on the home network (self-hosted Nextcloud):
	     iOS 14+ asks before an app may reach local-network addresses. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Cycle syncs your rides with your own server on your home network.</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Cycle</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>cycle</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Register Cycle as an opener for .gpx files (Files app, Mail, "Open in").
	     NOTE: delivering the opened file to Dart still needs an AppDelegate
	     `application(_:open:options:)` handler that forwards to the
	     `cycle/incoming_gpx` MethodChannel — to be added when building on macOS.
	     Until then the Dart side safely no-ops on iOS. -->
	<!-- Custom URL scheme for the Strava OAuth redirect (cycle://strava-callback).
	     Delivering it to Dart needs an AppDelegate application(_:open:options:)
	     handler forwarding to the cycle/oauth channel — a macOS-time TODO. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.cycleapp.cycle.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cycle</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>GPX route</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.topografix.gpx</string>
				<string>public.xml</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.topografix.gpx</string>
			<key>UTTypeDescription</key>
			<string>GPX route</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>gpx</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/gpx+xml</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
